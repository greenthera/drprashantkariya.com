{
  "rewrites": [
    {
      "source": "/api/courses",
      "destination": "https://drprashantkariya.graphy.com/s/store/subfilters/courses?page=0&limit=4&sortBy=relevance&domainName=drprashantkariya.graphy.com"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/courses",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}